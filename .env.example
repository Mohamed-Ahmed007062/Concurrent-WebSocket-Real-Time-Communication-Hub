# Server Configuration
PORT=3000
NODE_ENV=development

# Redis Configuration (In-Memory Database for Active Users & Presence)
# If Redis is not available locally, the server automatically uses in-memory mock mode.
REDIS_URL=redis://127.0.0.1:6379
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
USE_REDIS_MOCK=false

# Persistent File Store Logging
LOG_DIR=./logs
LOG_FILE_PREFIX=transactions
LOG_FLUSH_INTERVAL_MS=500

# Concurrency & Security Limits
MAX_MESSAGE_LENGTH=2048
RATE_LIMIT_WINDOW_MS=1000
RATE_LIMIT_MAX_MESSAGES=15
PING_INTERVAL_MS=25000
PING_TIMEOUT_MS=20000
